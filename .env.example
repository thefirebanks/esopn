# ESOPN Configuration
# Copy this file to .env and fill in your values

# Required: Google Gemini API key
# Get one at: https://aistudio.google.com/apikey
ESOPN_GEMINI_API_KEY=your_api_key_here

# Optional: ElevenLabs key (only needed for ESOPN_TTS_PROVIDER=elevenlabs)
# ESOPN_ELEVENLABS_API_KEY=your_key_here

# Privacy note: screenshots are sent to Gemini for analysis.
# Avoid capturing screens that show sensitive data.

# Optional: Override default settings
# ESOPN_CAPTURE_INTERVAL=5.0
# ESOPN_CAPTURE_MONITOR=1
# ESOPN_TTS_DEVICE=cuda
# ESOPN_VISION_MODEL=gemini-2.0-flash
